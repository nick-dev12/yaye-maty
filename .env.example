# Django
SECRET_KEY=votre-cle-secrete-django
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL — local
DB_NAME=yayematy_db
DB_USER=postgres
DB_PASSWORD=votre_mot_de_passe
DB_HOST=localhost
DB_PORT=5432

# PostgreSQL VPS (connexion directe) — VPS : sudo bash deploy/configure-postgres-remote.sh all

# API Intelligence (VPS ↔ machine locale NLP)
INTELLIGENCE_API_KEY=changez-moi-cle-secrete

# Scraping VPS
SOCIAL_SCRAPER_HEADLESS=False

# Celery + Redis (tâches asynchrones — scraping, NLP)
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
# Windows (dev local) : solo — obligatoire, prefork provoque PermissionError
# Linux VPS : prefork (défaut) ou laisser vide
# CELERY_WORKER_POOL=solo
# CELERY_WORKER_CONCURRENCY=1

# NLP CamemBERT sur le VPS (True = analyse hybride complète)
NLP_CLASSIFIER_ENABLED=True
NLP_MODEL_NAME=cmarkea/distilcamembert-base-nli
NLP_CONFIDENCE_THRESHOLD=0.55

# DeepSeek — Trade Intelligence (analyse Top 10, jamais committer la clé)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
DEEPSEEK_ANALYSIS_ENABLED=True
DEEPSEEK_THINKING_ENABLED=False
DEEPSEEK_MAX_TOKENS=8192
DEEPSEEK_TIMEOUT_SECONDS=120
# Veille web Trade Intelligence — marché SN (CSV). Web ouvert en complément.
# Ne pas y mettre les plateformes d’import (Alibaba, 1688, DHgate…) — Import Master only.
DEEPSEEK_WEB_ALLOWED_DOMAINS=jumia.sn,jiji.sn,promo.sn,expat-dakar.com,sn.coinafrique.com,jemba.sn,dakarcenter.com,occasiondakar.com,taftaf.sn,facebook.com,instagram.com,tiktok.com
DEEPSEEK_WEB_OPEN_SEARCH=True
# DEEPSEEK_WEB_BLOCKED_DOMAINS=
DEEPSEEK_WEB_MAX_USES=5
DEEPSEEK_WEB_MAX_TOURS=3
DEEPSEEK_WEB_COUNTRY=SN
DEEPSEEK_WEB_CITY=Dakar
DEEPSEEK_WEB_TIMEZONE=Africa/Dakar

# Trade Intelligence — limites collecte ad-hoc
TRADE_RESEARCH_MAX_PRODUCTS=8
TRADE_RESEARCH_MAX_LISTINGS=8
TRADE_RESEARCH_MAX_SOCIAL=8
TRADE_RESEARCH_MAX_REVIEWS=10

# Collecte automatique Celery Beat — False = lancer via /intelligence/collecte/ uniquement
COLLECTION_ENABLED=False
# COLLECTION_CAMPAIGN_START=2026-07-25
# COLLECTION_CAMPAIGN_DAYS=3
# Max vidéos TikTok / session (= plafond produits Jumia en mode test)
COLLECTION_MAX_VIDEOS_SESSION=15
# Jiji — contacts masqués par défaut (quotas IP)
COLLECTION_JIJI_REVEAL_CONTACTS=False
COLLECTION_JIJI_SKIP_KNOWN=True
COLLECTION_JIJI_SEARCH_FIRST=True
COLLECTION_JIJI_HOMEPAGE=True
COLLECTION_JIJI_HOMEPAGE_MAX=3
