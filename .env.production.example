# Copier vers .env sur le VPS : cp .env.production.example .env && nano .env

# Django
SECRET_KEY=generer-avec-get_random_secret_key
DEBUG=False
ALLOWED_HOSTS=analyse.yayematy.com,173.249.41.61,localhost,127.0.0.1

# PostgreSQL (Webuzo — utiliser 127.0.0.1, pas localhost, si erreur Ident auth)
DB_NAME=colobanes_yaye
DB_USER=colobanes_jomas
DB_PASSWORD=mot_de_passe_webuzo
DB_HOST=127.0.0.1
DB_PORT=5432

# API Intelligence (optionnel — réservé aux intégrations externes / dev local)
INTELLIGENCE_API_KEY=cle-api-aleatoire-longue

# Scraping VPS
SOCIAL_SCRAPER_HEADLESS=True
CELERY_UI_LAUNCH=False

# Celery + Redis
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# NLP CamemBERT sur VPS (chaîne complète autonome — ne pas désactiver en prod)
NLP_CLASSIFIER_ENABLED=True
NLP_MODEL_NAME=cmarkea/distilcamembert-base-nli
NLP_CONFIDENCE_THRESHOLD=0.55
# Optionnel — téléchargements Hugging Face plus rapides :
# HF_TOKEN=votre_token_huggingface

# Limites NLP par session planifiée (ajuster selon RAM VPS)
COLLECTION_NLP_COMMENTS=200
COLLECTION_NLP_POSTS=100

# Campagne collecte (COLLECTION_CAMPAIGN_DAYS > 0 active la fenêtre)
COLLECTION_ENABLED=True
COLLECTION_CAMPAIGN_START=2026-07-27
COLLECTION_CAMPAIGN_DAYS=3
COLLECTION_MAX_VIDEOS_SESSION=15

# Jumia / Jiji
COLLECTION_JUMIA_SKIP_KNOWN=True
COLLECTION_JUMIA_HOMEPAGE=True
COLLECTION_JUMIA_HOMEPAGE_MAX=3
COLLECTION_JIJI_REVEAL_CONTACTS=False
COLLECTION_JIJI_SKIP_KNOWN=True
COLLECTION_JIJI_SEARCH_FIRST=True
COLLECTION_JIJI_HOMEPAGE=True
COLLECTION_JIJI_HOMEPAGE_MAX=3
