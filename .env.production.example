# Copier vers .env sur le VPS : cp .env.production.example .env && nano .env

# Django
SECRET_KEY=generer-avec-get_random_secret_key
DEBUG=False
ALLOWED_HOSTS=analyse.yayematy.com,173.249.41.61,localhost,127.0.0.1

# PostgreSQL (Webuzo — utiliser 127.0.0.1, pas localhost, si erreur Ident auth)
DB_NAME=colobanes_yaye
DB_USER=colobanes_jomas
DB_PASSWORD=mot_de_passe_webuzo
DB_HOST=127.0.0.1
DB_PORT=5432

# API Intelligence (optionnel — réservé aux intégrations externes / dev local)
INTELLIGENCE_API_KEY=cle-api-aleatoire-longue

# Scraping VPS
SOCIAL_SCRAPER_HEADLESS=True
CELERY_UI_LAUNCH=False

# Celery + Redis
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# NLP CamemBERT sur VPS (chaîne complète autonome — ne pas désactiver en prod)
NLP_CLASSIFIER_ENABLED=True
NLP_MODEL_NAME=cmarkea/distilcamembert-base-nli
NLP_CONFIDENCE_THRESHOLD=0.55
# Optionnel — téléchargements Hugging Face plus rapides :
# HF_TOKEN=votre_token_huggingface

# DeepSeek — Trade Intelligence + Import Master
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
DEEPSEEK_ANALYSIS_ENABLED=True
DEEPSEEK_THINKING_ENABLED=False
DEEPSEEK_MAX_TOKENS=8192
DEEPSEEK_TIMEOUT_SECONDS=120
# Veille web Trade Intelligence — marché SN (CSV) + web ouvert
# Plateformes d’import (Alibaba, 1688, DHgate…) = Import Master uniquement (pas ici)
DEEPSEEK_WEB_ALLOWED_DOMAINS=jumia.sn,jiji.sn,promo.sn,expat-dakar.com,sn.coinafrique.com,jemba.sn,dakarcenter.com,occasiondakar.com,taftaf.sn,facebook.com,instagram.com,tiktok.com
DEEPSEEK_WEB_OPEN_SEARCH=True
DEEPSEEK_WEB_MAX_USES=5
DEEPSEEK_WEB_COUNTRY=SN
DEEPSEEK_WEB_CITY=Dakar
DEEPSEEK_WEB_TIMEZONE=Africa/Dakar
# Veille web — caractères (12000 par défaut) et tours selon durée analyse
DEEPSEEK_WEB_CHUNK_MAX_CHARS=12000
DEEPSEEK_WEB_STORED_CONTEXT_MAX_CHARS=12000
DEEPSEEK_ANALYSIS_PAYLOAD_MAX_CHARS=12000
DEEPSEEK_ANALYSIS_WEB_CONTEXT_MAX_CHARS=12000
# Tours veille web par session Trade Intelligence (fixe, pas lié à la durée UI)
DEEPSEEK_WEB_MAX_TOURS=3

# Trade Intelligence — source marketplace (catalog|live pour Jumia, database|live pour Jiji)
TRADE_RESEARCH_JUMIA_SOURCE=catalog
TRADE_RESEARCH_JUMIA_CATALOG_PRODUCTS_PER_TOUR=100
TRADE_RESEARCH_JUMIA_CATALOG_MAX_TOURS=3
TRADE_RESEARCH_JUMIA_CATALOG_FALLBACK_LIVE=0
TRADE_RESEARCH_JIJI_SOURCE=live
TRADE_RESEARCH_JIJI_DATABASE_LISTINGS_PER_TOUR=100
TRADE_RESEARCH_JIJI_DATABASE_MAX_TOURS=3
TRADE_RESEARCH_JIJI_DATABASE_FALLBACK_LIVE=0

# Limites NLP par session planifiée (ajuster selon RAM VPS)
COLLECTION_NLP_COMMENTS=200
COLLECTION_NLP_POSTS=100

# Collecte automatique (Celery Beat) — False = tout manuel via /intelligence/collecte/
# Inclut : Google Trends, réseaux, Jumia, Jiji, NLP auto, Top 10, Import Master quotidien
COLLECTION_ENABLED=False
# Si True : fenêtre campagne optionnelle (COLLECTION_CAMPAIGN_START + COLLECTION_CAMPAIGN_DAYS)
# COLLECTION_CAMPAIGN_START=2026-07-27
# COLLECTION_CAMPAIGN_DAYS=3
COLLECTION_MAX_VIDEOS_SESSION=15

# Jumia / Jiji
COLLECTION_JUMIA_SKIP_KNOWN=True
COLLECTION_JUMIA_HOMEPAGE=True
COLLECTION_JUMIA_HOMEPAGE_MAX=3
COLLECTION_JIJI_REVEAL_CONTACTS=False
COLLECTION_JIJI_SKIP_KNOWN=True
COLLECTION_JIJI_SEARCH_FIRST=True
COLLECTION_JIJI_HOMEPAGE=True
COLLECTION_JIJI_HOMEPAGE_MAX=3
